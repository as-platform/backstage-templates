{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "schedule": [
    "before 6am on monday"
  ],
  "packageRules": [
    {
      "description": "Mend cloud app cannot reach zot.homelab",
      "matchPackageNames": [
        "zot.homelab/**"
      ],
      "enabled": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Wait for new releases to settle before proposing updates",
      "matchPackageNames": [
        "*"
      ],
      "minimumReleaseAge": "7 days"
    }
  ]
}
